# TensorFold Home backend settings. TensorFold Home and tfctl edit these; by hand, edit then `tfctl engine restart`.

# Model key from models.conf
MODEL=qwythos-9b
# Prompt + reply window. Hermes refuses endpoints under 64,000 tokens.
CONTEXT=65536
# on|off: whether the chat template opens a reasoning block by default (off is faster)
THINKING=off
# always = keep the model loaded; idle = unload after IDLE_MINUTES without requests; ondemand = load on the first
# request (nothing loads when the app opens) and unload when idle. The endpoint wakes an unloaded model on demand.
MEMORY_MODE=idle
IDLE_MINUTES=30

# Stable endpoint for Hermes, Open WebUI and any OpenAI/Anthropic client: http://127.0.0.1:GATEWAY_PORT/v1
GATEWAY_PORT=8484
# Internal TensorFold server port (clients should use the gateway)
ENGINE_PORT=18484
# Open WebUI chat
WEBUI_PORT=3000
# Model id every client uses, whatever model is loaded
SERVED_NAME=tensorfold

# 1 = keep the endpoint gateway running from login so Hermes can always reach it (it starts the engine on demand)
ENDPOINT_AT_LOGIN=1
# Serve the endpoint to other computers on the network (0.0.0.0). With REQUIRE_KEY=1 they must send the key in
# state/api_key (Authorization: Bearer <key> or x-api-key); requests from this Mac never need it.
SHARE_ON_NETWORK=0
REQUIRE_KEY=0

# Daily auto-update of TensorFold and Open WebUI (1 = on), and its time (24h clock, local)
AUTO_UPDATE=1
UPDATE_HOUR=4
UPDATE_MINUTE=30
